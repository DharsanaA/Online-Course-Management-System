# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Database name
MONGO_DB_NAME=online_course_management

# Secret key for Flask session cookie signing (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here

# Set to 1 when serving over HTTPS (Vercel production), or 0 for local development
SESSION_COOKIE_SECURE=1

# Codes required on the register page to create staff or admin accounts
STAFF_SIGNUP_CODE=your_staff_signup_code_here
ADMIN_SIGNUP_CODE=your_admin_signup_code_here

# Optional: Upload directory root (defaults to /tmp/uploads on Vercel)
# UPLOAD_ROOT=/tmp/uploads
